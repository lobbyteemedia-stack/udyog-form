# সাইটের নাম (উপরে দেখাবে)
SITE_NAME=উদ্যোগ ফরম সহায়তা
# পোর্ট
PORT=3000
# ডাউনলোড ফি (টাকা)
PRICE=100
# পেমেন্ট নেওয়ার নম্বর (Send Money)
BKASH_NUMBER=01744311005
NAGAD_NUMBER=01744311005
# অ্যাডমিন প্যানেল লগইন (/admin)
ADMIN_USER=admin
ADMIN_PASS=এখানে-শক্ত-পাসওয়ার্ড-দিন
# কতদিন পর পুরনো আবেদন (ব্যক্তিগত তথ্য) মুছে যাবে
KEEP_DAYS=60

# Postgres ডেটাবেস (Render-এর মতো ফ্রি হোস্টিংয়ে অবশ্যই দিন, নইলে রিস্টার্টে আবেদন মুছে যাবে)
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
